<Window x:Class="wp.EditServiceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Редактирование услуги"
 Height="510" Width="590" Background="#FF698FC1">

    <Grid Margin="30">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
              VerticalAlignment="Top" Margin="-9,89,9,0">
            <Border Width="125"
           Height="125"
           BorderThickness="1"
           OpacityMask="Black" BorderBrush="#FF636363">

                <TextBlock Text="Изображение"
               Foreground="{x:Null}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
            </Border>
            <Button Content="Выбрать изображение"
           FontSize="12"
           Height="32"
           Click="ChooseImage_Click" Width="162"/>

        </StackPanel>

        <StackPanel Grid.Column="1"
              VerticalAlignment="Center"
              Margin="22,0,0,0">

            <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.383,0.644"
               >

                <Border Width="34"
            Height="34"
            CornerRadius="17"
            Background="#B9D9F4">

                    <TextBlock Text="♟"
                FontSize="22"
                Foreground="#547AA8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Edit Service"
               FontSize="18"
               FontWeight="Bold"
               VerticalAlignment="Center"
               Margin="8,0" Foreground="White"/>

            </StackPanel>

            <TextBlock Text="Введите наименование услуги"/>
            <TextBox x:Name="ServiceNameBox" BorderBrush="{x:Null}"/>

            <TextBlock Text="Введите описание услуги"/>
            <TextBox x:Name="DescriptionBox"
            Height="18"
            AcceptsReturn="True"
            TextWrapping="Wrap" TextChanged="DescriptionBox_TextChanged" BorderBrush="{x:Null}"/>

            <TextBlock Text="Введите цену услуги"/>
            <TextBox x:Name="PriceBox" BorderBrush="{x:Null}"/>

            <TextBlock Text="Выберите тип услуги"/>

            <ComboBox x:Name="ServiceTypeBox" BorderBrush="{x:Null}">
                <ComboBoxItem Content="Стрижка"/>
                <ComboBoxItem Content="Укладка"/>
                <ComboBoxItem Content="Окрашивание"/>
                <ComboBoxItem Content="Другое"/>
            </ComboBox>

            <Button Content="Изменить"
           Width="130"
           HorizontalAlignment="Center"
           Margin="0,18,0,0"
           Click="Save_Click" Height="32"/>

        </StackPanel>

    </Grid>
</Window>